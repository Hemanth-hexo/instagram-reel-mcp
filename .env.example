# Copy to .env and adjust. Real environment variables override this file.

# --- Server
REEL_HOST=127.0.0.1
REEL_PORT=8000
# Path of the MCP endpoint. A long random path works as a shared secret for clients that
# cannot send headers (claude.ai / ChatGPT connectors), e.g. /mcp/3f9c1e...
REEL_MCP_PATH=/mcp
# Require "Authorization: Bearer <token>" on every request except /healthz and the upload page.
# Strongly recommended whenever the server is reachable from outside your machine.
# REEL_AUTH_TOKEN=change-me
# Extra Host headers to accept (needed behind a tunnel or domain), comma separated.
# REEL_ALLOWED_HOSTS=abc123.ngrok-free.app

# --- Access methods
# Anonymous download of PUBLIC reels (no login, no cookies). Set 0 to only allow uploaded files.
REEL_PUBLIC_FETCH=1
# Official Meta oEmbed metadata: "<app-id>|<client-token>" from a Meta app with oEmbed Read.
# REEL_META_ACCESS_TOKEN=
# REEL_GRAPH_VERSION=v23.0

# --- Storage and limits
REEL_DATA_DIR=data
REEL_CACHE_TTL_S=3600
REEL_UPLOAD_TTL_S=86400
REEL_MAX_VIDEO_MB=150
REEL_MAX_DURATION_S=300
REEL_MAX_UPLOAD_MB=200
REEL_MAX_CONCURRENT_JOBS=2

# --- Transcription (needs: pip install 'reel-mcp[transcribe]')
# tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
REEL_WHISPER_MODEL=base
REEL_WHISPER_DEVICE=auto
REEL_WHISPER_COMPUTE_TYPE=int8

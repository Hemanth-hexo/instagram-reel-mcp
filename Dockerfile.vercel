# Vercel Container Runtime image (Vercel detects this file and routes all traffic to it).
# Differences from ./Dockerfile: listens on $PORT (Vercel's default is 80), keeps writable data in
# /tmp, and bakes the speech model into the image so cold starts don't download it.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[transcribe]" \
    && python -c "from faster_whisper import download_model; download_model('base', output_dir='/opt/whisper-base')"

ENV REEL_HOST=0.0.0.0 \
    PORT=80 \
    REEL_DATA_DIR=/tmp/reel-data \
    REEL_WHISPER_MODEL=/opt/whisper-base \
    REEL_MAX_UPLOAD_MB=4 \
    PYTHONUNBUFFERED=1

CMD ["reel-mcp", "serve"]
